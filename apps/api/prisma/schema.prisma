generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quote {
  id        String   @id @default(uuid())
  text      String
  author    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("quotes")
  @@index([createdAt(sort: Desc)])
}
